; energy minimisation, framework frozen so only CO2 relaxes
integrator      = steep
nsteps          = 5000
emtol           = 1000.0
emstep          = 0.01

cutoff-scheme   = Verlet
nstlist         = 10
pbc             = xyz

coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0

freezegrps      = Framework
freezedim       = Y Y Y

;ensured no CO2 overlaps at the start of the command